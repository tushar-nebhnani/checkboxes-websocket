# Server
PORT=8000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Database (Postgres/Neon connection string)
DATABASE_URL=postgres://user:password@localhost:5432/checkboxes

# Redis / Valkey
REDIS_URI=redis://localhost:6379

# Auth tokens
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24

# SMTP (leave SMTP_HOST unset to log emails to the console instead of sending)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-username
SMTP_PASS=smtp-password
EMAIL_FROM=Checkboxes <no-reply@checkboxes.local>